{
    "manifest_version": 3,
    
    "name": "My first extension",

    "version": "1.0",

    "description": "The smallest extension chrome/firefox/safari extension",

    "icons": {
        "48": "icons/border-48.png"
    },

    "browser_specific_settings": {
        "gecko": {
          "id": "chrome-extension-tutorial@mozilla.org",
            "data_collection_permissions": {
                "required": ["none"]
            }
        }
    },

    "action": {
        "default_popup": "popup.html",
        "default_title": "Open the counter"
    },

    "content_scripts": [
        {
            "matches": ["*://*.mozilla.org/*"],
            "js": ["content.js"]
        }
    ]
}